# Copy this file to .env and fill in your real value.
# .env is in .gitignore — never commit real secrets.

# Used internally by rag.js for generating embeddings (semantic search).
GEMINI_API_KEY=your_gemini_key_here

# Port this server listens on.
PORT=3000

# --- LlamaIndex vector store connections ---
# All three default to the docker-compose.yml services in this folder,
# so you only need to set these if you're pointing at something else
# (a remote Qdrant/Chroma instance, a different Postgres, etc).

# ChromaDB (backs the hr-policy domain)
CHROMA_URL=http://localhost:8000

# Postgres/pgvector (backs the engineering domain)
PG_CONNECTION_STRING=postgresql://llamaindex:llamaindex@localhost:5433/engineering_docs

# Qdrant (backs the admin-policies domain)
QDRANT_URL=http://localhost:6333
